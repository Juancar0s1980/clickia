NODE_ENV=test
PORT=4001

DATABASE_URL=postgres://postgres:postgres@localhost:55432/clickia_test

JWT_SECRET=test-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

CORS_ORIGIN=http://localhost:5173

# Intencionalmente vacias: las pruebas deben ser deterministas y no llamar a
# un LLM real. Con ambas vacias, /chat siempre usa la plantilla de fallback.
GEMINI_API_KEY=
GROQ_API_KEY=

# Open-Meteo e ip-api.com no requieren API key, asi que se desactivan explicitamente por
# env var para que las pruebas no dependan de la red.
WEATHER_ENABLED=false
IP_LOOKUP_ENABLED=false

# OpenCage si requiere API key; OPENCAGE_API_KEY vacia ya desactiva geocoding.service sola,
# pero se apaga tambien por env var para que quede explicito y no dependa de la red.
GEOCODING_ENABLED=false

LOG_LEVEL=silent

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=1000

AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=5

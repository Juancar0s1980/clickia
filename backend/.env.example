NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/clickia_dev

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

CORS_ORIGIN=http://localhost:5173

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# gemini | groq | (vacio = autodetectar la primera API key configurada, groq primero)
AI_PROVIDER=

# Segunda API externa (clima, Open-Meteo): no requiere API key. true|false
WEATHER_ENABLED=true

LOG_LEVEL=info

# Rate limiting general por IP (ventana en ms + maximo de requests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Rate limiting especifico para /users (registro) y /auth/* (fuerza bruta)
AUTH_RATE_LIMIT_MAX=10

# Rate limiting de uso de IA por usuario autenticado (AI Guard)
AI_RATE_LIMIT_WINDOW_MS=300000
AI_RATE_LIMIT_MAX=15
